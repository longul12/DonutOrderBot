{
  "schemaVersion": 1,
  "id": "kami-order-bot",
  "version": "${version}",
  "name": "KamiOrderBot",
  "description": "Meteor Addon by kami: Auto Order SMP (shift-double-click fill).",
  "authors": [
    "kami"
  ],
  "contact": {
    "sources": "https://github.com/kami/kami-order-bot"
  },
  "icon": "assets/kamiorder/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.kami.order.KamiOrderAddon"
    ]
  },
  "mixins": [
    "kami-order-bot.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "255,170,0",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": "1.21.11",
    "meteor-client": "*"
  }
}
